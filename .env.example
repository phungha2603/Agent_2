# --- Provider toggles: "mock" by default. ---
GEMINI_PROVIDER=mock   # mock | real
CLAUDE_PROVIDER=mock   # mock | api (pay-per-token) | cli (uses your Claude Code subscription)
MUSE_PROVIDER=mock     # mock | real

# --- Gemini (role: ideation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Claude (role: architecture + final sign-off) ---
# CLAUDE_PROVIDER=api  -> calls api.anthropic.com directly, billed per token.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_PROVIDER=cli  -> instead shells out to the local `claude` CLI
# (claude -p "..."), using your existing Claude Code subscription quota
# instead of separate API billing. Requires `claude` installed and logged
# in on this machine. No ANTHROPIC_API_KEY needed for this mode.
CLAUDE_CLI_COMMAND=claude

# --- Muse (role: implementation), via github.com/duclm1x1/Muse-Chat-MCP ---
# Absolute path to that repo's muse-server.mjs, cloned on THIS machine.
MUSE_MCP_SERVER_PATH=/absolute/path/to/Muse-Chat-MCP/muse-server.mjs
MUSE_PROFILE_DIR=/absolute/path/to/Muse-Chat-MCP/.muse-profile
# How long (seconds) to let Muse take typing a reply before giving up.
# Raise this if implementation prompts are large/complex.
MUSE_TIMEOUT_SEC=300

# --- Verification gate: the real commands run against the project Muse is
# coding in. A task can only pass if these actually succeed. ---
VERIFY_CWD=/absolute/path/to/the/project/being/built
VERIFY_COMMANDS=npm install,npm run build,npm test

MAX_IMPLEMENTATION_ATTEMPTS=3
MAX_REVIEW_REJECTIONS=3

# --- Optional visual review loop (for UI/visual projects) ---
# Setting this turns the loop on: Gemini generates a reference style image
# at ideation time, and a real screenshot of the freshly built output is
# taken after each verification pass (served as static files on a fresh
# port — not the project's own dev server, so nothing from a previous
# attempt can be left running and serve stale content), so Gemini's review
# can compare the two images directly instead of only reading text/code.
# REFERENCE_IMAGE_PROMPT=a cyberpunk city street at night, WebGL low-poly style, neon signs
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Built output directory to screenshot, relative to VERIFY_CWD. Must
# already be produced by VERIFY_COMMANDS (e.g. "npm run build" with Vite
# normally outputs to "dist").
BUILD_OUTPUT_DIR=dist
SCREENSHOT_WAIT_MS=3000
