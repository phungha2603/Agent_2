# --- Provider toggles: "real" or "mock" (default mock if unset) ---
GEMINI_PROVIDER=mock
CLAUDE_PROVIDER=mock
MUSE_PROVIDER=mock

# --- Gemini (role: ideation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Claude (role: architecture + final sign-off) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Muse (role: implementation), via github.com/duclm1x1/Muse-Chat-MCP ---
# Absolute path to that repo's muse-server.mjs, cloned on THIS machine.
MUSE_MCP_SERVER_PATH=/absolute/path/to/Muse-Chat-MCP/muse-server.mjs
MUSE_PROFILE_DIR=/absolute/path/to/Muse-Chat-MCP/.muse-profile

# --- Verification gate: the real commands run against the project Muse is
# coding in. A task can only pass if these actually succeed. ---
VERIFY_CWD=/absolute/path/to/the/project/being/built
VERIFY_COMMANDS=npm install,npm run build,npm test

MAX_IMPLEMENTATION_ATTEMPTS=3
MAX_REVIEW_REJECTIONS=3
