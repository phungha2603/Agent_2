# --- Provider toggles: "mock" by default. ---
GEMINI_PROVIDER=mock   # mock | real
CLAUDE_PROVIDER=mock   # mock | api (pay-per-token) | cli (uses your Claude Code subscription)
MUSE_PROVIDER=mock     # mock | real

# --- Gemini (role: ideation) ---
GEMINI_API_KEY=
# Optional key pool (multiple Google accounts) — auto-rotates to the next
# key on a 429. When set, it's used instead of GEMINI_API_KEY above.
# GEMINI_API_KEYS=key-from-account-1,key-from-account-2,key-from-account-3
GEMINI_MODEL=gemini-2.5-pro

# --- Claude (role: architecture + final sign-off) ---
# CLAUDE_PROVIDER=api  -> calls api.anthropic.com directly, billed per token.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_PROVIDER=cli  -> instead shells out to the local `claude` CLI
# (claude -p "..."), using your existing Claude Code subscription quota
# instead of separate API billing. Requires `claude` installed and logged
# in on this machine. No ANTHROPIC_API_KEY needed for this mode.
CLAUDE_CLI_COMMAND=claude
# Stream Claude CLI output token by token to the dashboard (0 = plain output).
CLAUDE_CLI_STREAM=1
# Kill a Claude CLI call that hangs longer than this (it's then retried).
CLAUDE_CLI_TIMEOUT_SEC=900
# Tokens per call: a default `claude -p` carries all of Claude Code's tools,
# skills and MCP servers in every prompt (~37,000 input tokens for one word,
# measured). Empty (default) switches them off (~3,000) — this pipeline sends
# everything Claude needs in the prompt. "Read,Grep,Glob" lets it open files
# from VERIFY_CWD itself (~6-15k); "default" restores the full CLI.
# Regardless of this setting, the architecture and final-review calls always
# get Read,Grep,Glob in the task's own project directory, so the guide and
# the sign-off rest on the files actually on disk.
CLAUDE_CLI_TOOLS=
# The architecture step reads files itself (Read,Grep,Glob) on top of the
# file contents the orchestrator already includes; each file it opens is a
# turn that re-sends the whole context. This caps those turns (default 8);
# on reaching it the step is redone without tools. Final reviews never get
# tools. CLAUDE_CLI_MAX_TURNS=8

# Claude model per step (unset = CLAUDE_MODEL): the architecture guide decides
# how much rework follows, reviews and plans are lighter work, e.g.
# CLAUDE_MODEL_ARCHITECTURE=claude-opus-5-5
# CLAUDE_MODEL_REVIEW=claude-sonnet-5-5
# CLAUDE_MODEL_PLAN=claude-sonnet-5-5

# "Auto Content SEO" tab: an existing project (Python Telegram bot that writes
# SEO articles into Google Drive) run from the dashboard with its own .venv and
# .env — run its pipeline from a form, start/stop its bot.
# CONTENTSEO_DIR=/absolute/path/to/autocontentseo

# macOS notifications when a task waits for you, stops, or a plan finishes.
# NOTIFY=0 turns them off.

# --- Muse (role: implementation), via github.com/duclm1x1/Muse-Chat-MCP ---
# Absolute path to that repo's muse-server.mjs, cloned on THIS machine. It must
# be a version that returns replies as Markdown (replyFormat markdown-copy or
# markdown-dom): replies read off the rendered page lose `#` comments,
# indentation and `__names__`, so the orchestrator refuses them.
MUSE_MCP_SERVER_PATH=/absolute/path/to/Muse-Chat-MCP/muse-server.mjs
MUSE_PROFILE_DIR=/absolute/path/to/Muse-Chat-MCP/.muse-profile
# Optional account pool — one Chrome profile per logged-in Muse account
# (each created with `MUSE_PROFILE_DIR=... npm run muse:login`), run in
# parallel, one chat at a time per account. When set, used instead of the
# single MUSE_PROFILE_DIR above.
# MUSE_PROFILE_DIRS=/abs/path/profile-1,/abs/path/profile-2,/abs/path/profile-3
# MUSE_CONCURRENCY=3   # defaults to the number of profiles above
# How long (seconds) to let Muse take typing a reply before giving up.
# Raise this if implementation prompts are large/complex.
MUSE_TIMEOUT_SEC=300

# --- Verification gate: the real commands run against the project Muse is
# coding in. A task can only pass if these actually succeed. ---
# A plan sets its own project directory and commands (the CEO confirms them
# before approving); these two are only the default directory offered in the
# dashboard and the settings for single tasks created outside a plan. With no
# commands at all, verification fails — it never passes on a placeholder.
# Verification runs in a copy of the project under data/workspaces/ and the
# engineer's files reach the project only once every check passes, so a
# failed attempt (or a test with side effects) never touches the project.
# VERIFY_ISOLATE=0 turns this off; VERIFY_SYNC_EXCLUDE adds comma-separated
# paths (beyond .build, .swiftpm, .venv, node_modules, DerivedData, build)
# that are not copied and whose cached copies in the workspace are kept.
VERIFY_CWD=/absolute/path/to/the/project/being/built
# With PROJECTS_ROOT set, a plan whose directory field is left empty gets its
# own new folder there, named after the goal (-2, -3... if taken), and every
# plan's folder is made a git repository when the plan is approved.
# PROJECTS_ROOT=/absolute/path/to/projects
# A plan can also get its own GitHub repository (the "Tạo repo GitHub riêng"
# option, on by default): created through the logged-in `gh` CLI when the plan
# is approved, private unless GITHUB_PROJECTS_VISIBILITY=public; every approved
# task is committed and pushed to it. GITHUB_PROJECTS=0 turns GitHub off.
VERIFY_COMMANDS=npm install,npm run build,npm test

MAX_IMPLEMENTATION_ATTEMPTS=3
MAX_REVIEW_REJECTIONS=3
# Claude/Gemini can go back and forth on the architecture spec this many
# rounds before giving up (meant as a safety ceiling, not a real limit —
# "no limit" per the prompt, but something has to stop a true runaway loop).
MAX_ARCHITECTURE_ROUNDS=20
# When implementation/review attempts run out, send the task back to Claude
# to revise the architecture with all the feedback this many times before
# marking it rejected.
MAX_AUTO_RECOVERIES=1

# --- Dashboard access ---
# 127.0.0.1 = reachable from this machine only (and from a tunnel/proxy on
# it). Anything else requires DASHBOARD_USER + DASHBOARD_PASSWORD, or the
# server refuses to start: whoever reaches the dashboard can make the agents
# write and run code. See DEPLOY.md for putting it on a domain safely.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4000
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Claude CLI on a server without a browser: token from `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Dashboard capacity (company scheduler) ---
# Calls allowed to run at once per engine. Muse is always 1 (one browser),
# and implementation+verification is always one task at a time (they share
# VERIFY_CWD). Lower GEMINI_CONCURRENCY if you hit free-tier rate limits.
CLAUDE_CONCURRENCY=2
GEMINI_CONCURRENCY=2
# Tasks one staff member may have in progress at once; the rest queue.
SLOT_MAX_PARALLEL=1
# Per-staff overrides, e.g. AG-05:2,AG-03:2
SLOT_PARALLEL_OVERRIDES=
# Automatic retries of a stage that crashes (network, CLI error) before the
# task pauses with the error shown on its card.
STAGE_ERROR_RETRIES=2
# When a finished task hands its result to the tasks that depend on it:
# checkpoint_final = as soon as it's verified and Claude signed off (faster,
# dependents start while you review), done = only after you approve it.
HANDOFF_ON=checkpoint_final
# Boss planning: Claude drafts, Gemini reviews, up to this many rounds.
PLAN_MAX_REVIEW_ROUNDS=3
PLAN_MAX_EPICS=3
PLAN_MAX_SUBTASKS=8

# --- Cost estimate in the telemetry bar ---
# The Claude CLI reports its own (API-equivalent) cost per call — nothing to
# set for it. For the Gemini API / Claude API, set USD per million tokens to
# include them; unset means tokens are counted but cost isn't. Muse reports
# no usage at all (its tokens are estimated from text length, marked *).
# GEMINI_PRICE_IN_PER_MTOK=
# GEMINI_PRICE_OUT_PER_MTOK=
# CLAUDE_PRICE_IN_PER_MTOK=
# CLAUDE_PRICE_OUT_PER_MTOK=

# --- Dry runs only: make each mock agent call take this long (ms) and
# stream its reply, to watch queues/parallelism without spending quota. ---
MOCK_DELAY_MS=0

# --- Optional visual review loop (for UI/visual projects) ---
# Setting this turns the loop on: Gemini generates a reference style image
# at ideation time, and a real screenshot of the freshly built output is
# taken after each verification pass (served as static files on a fresh
# port — not the project's own dev server, so nothing from a previous
# attempt can be left running and serve stale content), so Gemini's review
# can compare the two images directly instead of only reading text/code.
# REFERENCE_IMAGE_PROMPT=a cyberpunk city street at night, WebGL low-poly style, neon signs
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Built output directory to screenshot, relative to VERIFY_CWD. Must
# already be produced by VERIFY_COMMANDS (e.g. "npm run build" with Vite
# normally outputs to "dist").
BUILD_OUTPUT_DIR=dist
SCREENSHOT_WAIT_MS=3000
