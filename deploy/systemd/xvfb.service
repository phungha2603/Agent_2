# Virtual screen :99 for Muse's Chrome (Muse-Chat-MCP drives a real, logged-in
# Chrome; a server has no monitor, so it gets this one).
# Install: sudo cp deploy/systemd/xvfb.service /etc/systemd/system/
[Unit]
Description=Virtual display :99 for Muse's Chrome
After=network.target

[Service]
User=aicompany
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x900x24 -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
